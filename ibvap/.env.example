# =============================================================================
# IBVAP — Environment Configuration Example
# Copy to .env and fill in your values. Never commit .env.
# =============================================================================

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
APP_ENV=development
# development | production | test

# ---------------------------------------------------------------------------
# Edge Agent
# ---------------------------------------------------------------------------
EDGE_SITE_ID=site-demo-01
EDGE_DEVICE_ID=edge-demo-01
EDGE_API_PORT=8001
EDGE_SECRET_KEY=change-me-edge-secret-key-at-least-32-chars

# Edge database (SQLite path, relative to edge-agent working dir)
EDGE_DATABASE_URL=sqlite+aiosqlite:///./data/edge.db

# Edge media storage
EDGE_MEDIA_DIR=./data/media
EDGE_LOGS_DIR=./data/logs

# Central API connection
CENTRAL_API_URL=http://central-api:8000
CENTRAL_API_KEY=change-me-edge-api-key

# AI Model configuration
MODEL_DETECTOR=mock
# mock | yolo11n | yolo11s | yolo26n
MODEL_DEVICE=cpu
# cpu | cuda | mps

# Processing rates (frames per second)
DETECTION_FPS=3
TRACKING_FPS=10
BEHAVIOR_INTERVAL_SEC=1

# Evidence capture
PRE_EVENT_SECONDS=5
POST_EVENT_SECONDS=10

# Sync
SYNC_ENABLED=true
SYNC_BATCH_SIZE=25
SYNC_RETRY_MAX=10
SYNC_RETRY_BACKOFF_BASE_SEC=1
SYNC_RETRY_BACKOFF_MAX_SEC=60

# Demo/simulation mode
DEMO_MODE=true
DEMO_DISCONNECT_CENTRAL=false

# Risk engine thresholds
RISK_LOW_MAX=19
RISK_MEDIUM_MAX=49
RISK_HIGH_MAX=79
# CRITICAL = 80-100

# Logging
LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR

# ---------------------------------------------------------------------------
# Central API
# ---------------------------------------------------------------------------
CENTRAL_API_PORT=8000
CENTRAL_SECRET_KEY=change-me-central-secret-key-at-least-32-chars

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://ibvap:ibvap_password@postgres:5432/ibvap
DATABASE_URL_SYNC=postgresql+psycopg2://ibvap:ibvap_password@postgres:5432/ibvap

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# PostgreSQL (used by Docker Compose)
# ---------------------------------------------------------------------------
POSTGRES_USER=ibvap
POSTGRES_PASSWORD=ibvap_password
POSTGRES_DB=ibvap
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
VITE_CENTRAL_API_URL=http://localhost:8000
VITE_EDGE_API_URL=http://localhost:8001
VITE_WS_URL=ws://localhost:8000/ws/dashboard
VITE_APP_TITLE=IBVAP — Border Video Analytics
