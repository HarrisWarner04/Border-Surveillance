# =============================================================================
# IBVAP Edge Agent — Environment Variables
# Copy to .env and fill in real values.  Never commit .env.
# =============================================================================

# --- Identity ---
APP_ENV=development
EDGE_SITE_ID=site-demo-01
EDGE_DEVICE_ID=edge-demo-01

# --- API ---
EDGE_API_PORT=8001
EDGE_SECRET_KEY=change-me-at-least-32-chars-long

# --- Database ---
EDGE_DATABASE_URL=sqlite+aiosqlite:///./data/edge.db

# --- Storage ---
EDGE_MEDIA_DIR=./data/evidence
EDGE_LOGS_DIR=./data/logs

# --- Central API ---
CENTRAL_API_URL=http://localhost:8000
CENTRAL_API_KEY=change-me-edge-api-key
SYNC_ENABLED=true
SYNC_BATCH_SIZE=25

# --- AI Model ---
# mock | yolo11n | yolo11s | yolo26n
MODEL_DETECTOR=mock
MODEL_PATH=models/yolo26n.pt
# auto | cpu | cuda | mps
MODEL_DEVICE=cpu
MODEL_CONFIDENCE_THRESHOLD=0.35
MODEL_IOU_THRESHOLD=0.50
MODEL_IMAGE_SIZE=640
MODEL_CLASSES=person,car,motorcycle,truck

# --- Processing ---
DETECTION_FPS=3
TRACKING_FPS=10
BEHAVIOR_INTERVAL_SEC=1.0

# --- Evidence ---
PRE_EVENT_SECONDS=5.0
POST_EVENT_SECONDS=10.0

# --- Risk Thresholds ---
RISK_LOW_MAX=19
RISK_MEDIUM_MAX=49
RISK_HIGH_MAX=79

# --- Intrusion ---
INTRUSION_CONFIRMATION_FRAMES=3
INTRUSION_ALERT_COOLDOWN_SECONDS=10.0
TRACK_STATE_TTL_SECONDS=30.0

# --- Demo ---
DEMO_MODE=true
DEMO_DISCONNECT_CENTRAL=false

# --- Logging ---
LOG_LEVEL=INFO

# --- RTSP Camera (example, use your own values) ---
# These are referenced by camera config — never hardcode in source.
CAMERA_0_ID=demo-camera-01
CAMERA_0_NAME=Demo Perimeter Camera
CAMERA_0_PROTOCOL=FILE
# For FILE protocol: path to local video file
CAMERA_0_STREAM_URI=data/fixtures/demo_walk.mp4
# For RTSP: rtsp://username:password@host/stream
# CAMERA_0_STREAM_URI=rtsp://admin:password@192.168.1.100:554/stream1
CAMERA_0_TARGET_FPS=10
CAMERA_0_ENABLED=true
OPEN_AI_API_KEY=xxysmkdnewk
